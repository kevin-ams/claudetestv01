# Copia este archivo a .env.local y completa los valores.

# Firma de la sesión (genera uno con: openssl rand -base64 32)
AUTH_SECRET=

# Google OAuth (Google Cloud Console → pantalla de consentimiento "Interna")
# URI de redirección: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_DOMAIN=amscreativeint.com

# Base de datos local (en Netlify la inyecta la plataforma)
NETLIFY_DB_URL=postgres://postgres:postgres@localhost:5432/ams_crm
NETLIFY_DB_DRIVER=server

# Acceso sin Google, solo con `npm run dev`
DEV_LOGIN=true
