# EOS Nivel 10 — variables de entorno (sin valores). Inventario completo: docs/seguridad/configuracion.md
# En Netlify se configuran en Project configuration › Environment variables. Las marcadas [secreta] van como
# "Contains secret values" y con alcance Functions (no Builds). Nunca subas un .env con valores al repositorio.

# --- Obligatorias en producción ---
AUTH_SECRET=            # [secreta] firma las sesiones; 32+ caracteres aleatorios. Sin ella la app no acepta sesiones.
CRON_SECRET=            # [secreta] protege /api/cron/* y las funciones programadas; 16+ caracteres.

# --- Opcionales (la integración se apaga si faltan) ---
APP_URL=                # URL pública para los enlaces de los correos (p. ej. https://eos.amscreativeint.com)
RESEND_API_KEY=         # [secreta] correos (Resend)
RESEND_FROM=            # remitente, p. ej. "EOS Nivel 10 <eos@tudominio.com>"
ACTIVECAMPAIGN_API_URL= # p. ej. https://cuenta.api-us1.com
ACTIVECAMPAIGN_API_KEY= # [secreta] sincronización de leads
CLICKUP_API_TOKEN=      # [secreta] importar tareas de ClickUp
CLICKUP_SPACE_NAME=     # espacio de ClickUp (por omisión "Marketing")
CLICKUP_SPACE_ID=       # alternativa al nombre
ANTHROPIC_API_KEY=      # [secreta] Asistente IA (premium)
AI_GLOBAL_MONTHLY_CAP_USD= # tope mensual de IA de toda la plataforma (por omisión 20)
CLARITY_PROJECT_ID=     # ID público de Microsoft Clarity (no es secreto)
PLATFORM_OWNER_EMAILS=  # correos del dueño de la plataforma, separados por comas
EOS_TIMEZONE=           # por omisión America/Guatemala

# --- Solo desarrollo y pruebas ---
EOS_FORCE_LOCAL_DB=     # "1" usa PGlite local aunque haya base en la nube
EOS_DATA_DIR=           # carpeta de PGlite (por omisión .data/pglite)
EOS_UPLOADS_DIR=        # carpeta de imágenes locales
